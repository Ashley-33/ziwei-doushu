# 复制为 .env.local 后填入实际值
#
# 只排盘、看命盘：整个文件都不用填。
# 想要「AI 命理解读」和「合盘 AI 分析」：填 AI_PROVIDER + 对应的 API Key 即可。

# ─── AI 解盘（OpenAI 兼容协议，任选一家）───
# 可选：deepseek / moonshot / zhipu / zai / siliconflow / dashscope / openrouter / openai / custom / mimo
AI_PROVIDER=deepseek

# DeepSeek：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 其他家按 AI_PROVIDER 填对应的 key（只填你用的那一个）：
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# ZAI_API_KEY=
# SILICONFLOW_API_KEY=
# DASHSCOPE_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ─── 覆盖默认模型 / 换中转站（可选）───
# 不给就用 provider 预设（deepseek → deepseek-chat）。AI_PROVIDER=custom 时这两项必填。
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ─── 旧版 MiMo 写法（AI_PROVIDER=mimo 时用，三项都要填）───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
